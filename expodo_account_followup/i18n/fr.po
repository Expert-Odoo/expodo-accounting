#. module: expodo_account_followup
#. odoo-python
#: code:addons/expodo_account_followup/models:0
msgid "“%(other)s” already triggers at %(days)s days. Two levels at the same delay would make the sequence arbitrary."
msgstr "« %(other)s » se déclenche déjà à %(days)s jours. Deux niveaux au même délai rendraient la séquence arbitraire."

#. module: expodo_account_followup
#: model_terms:ir.actions.act_window,help:expodo_account_followup.action_expodo_followup
msgid "No customer has an overdue unpaid item. Levels are set under Configuration; they trigger on how late the oldest unpaid instalment is."
msgstr "Aucun client n'a d'impayé échu. Les niveaux se règlent dans Configuration ; ils se déclenchent selon le retard de l'impayé le plus ancien."

#. module: expodo_account_followup
#: model_terms:ir.actions.act_window,help:expodo_account_followup.action_expodo_followup_level
msgid "Set the first level"
msgstr "Définir un premier niveau"

#. module: expodo_account_followup
#: model_terms:ir.actions.act_window,help:expodo_account_followup.action_expodo_followup_level
msgid "A level is a delay and a message. It is reached according to how late the oldest unpaid item is, so two levels sharing the same delay would compete for the same customer."
msgstr "Un niveau, c'est un délai et un message. Il est atteint selon le retard de l'impayé le plus ancien : deux niveaux partageant le même délai se disputeraient le même client."

