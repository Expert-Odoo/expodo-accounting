msgid "%(sent)s reminders sent out of %(total)s selected. Customers with no level reached, no email address, or a level that does not send email were skipped."
msgstr "%(sent)s solleciti inviati su %(total)s selezionati. Sono stati saltati i clienti senza livello raggiunto, senza indirizzo e-mail o con un livello che non invia e-mail."

#. module: expodo_account_followup
#. odoo-python
#: code:addons/expodo_account_followup/models:0
msgid "“%(other)s” already triggers at %(days)s days. Two levels at the same delay would make the sequence arbitrary."
msgstr "«%(other)s» scatta già a %(days)s giorni. Due livelli con lo stesso termine renderebbero arbitraria la sequenza."

#. module: expodo_account_followup
#: model_terms:ir.actions.act_window,help:expodo_account_followup.action_expodo_followup
msgid "No customer has an overdue unpaid item. Levels are set under Configuration; they trigger on how late the oldest unpaid instalment is."
msgstr "Nessun cliente ha un insoluto scaduto. I livelli si impostano in Configurazione; scattano in base al ritardo dell'insoluto più vecchio."

#. module: expodo_account_followup
#: model_terms:ir.actions.act_window,help:expodo_account_followup.action_expodo_followup_level
msgid "Set the first level"
msgstr "Definire il primo livello"

#. module: expodo_account_followup
#: model_terms:ir.actions.act_window,help:expodo_account_followup.action_expodo_followup_level
msgid "A level is a delay and a message. It is reached according to how late the oldest unpaid item is, so two levels sharing the same delay would compete for the same customer."
msgstr "Un livello è un termine e un messaggio. Viene raggiunto in base al ritardo dell'insoluto più vecchio: due livelli con lo stesso termine si contenderebbero lo stesso cliente."

