<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Cloisonnement multi-société.

            Sans ces règles, un utilisateur d'une société lit les
            immobilisations de toutes les autres : la valeur des biens, les
            comptes employés, le tableau d'amortissement. Rien ne le signale,
            puisque les droits d'accès du modèle sont satisfaits — seule la
            règle d'enregistrement pose la frontière.

            Le cas s'observe dès qu'un cabinet gère plusieurs dossiers dans la
            même base, ce qui est courant chez les intégrateurs.
        -->

        <record id="rule_expodo_asset_company" model="ir.rule">
            <field name="name">Fixed asset: multi-company</field>
            <field name="model_id" ref="model_expodo_asset"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False),
                      ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="rule_expodo_asset_line_company" model="ir.rule">
            <field name="name">Depreciation board line: multi-company</field>
            <field name="model_id" ref="model_expodo_asset_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False),
                      ('company_id', 'in', company_ids)]
            </field>
        </record>

    </data>
</odoo>
