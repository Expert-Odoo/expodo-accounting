#. module: expodo_account_assets
#. odoo-python
#: code:addons/expodo_account_assets/models/expodo_asset.py:0
msgid ""
"%(account)s is a profit and loss account. Accumulated depreciation must be "
"posted to a balance sheet account."
msgstr ""
"%(account)s è un conto economico. Il fondo ammortamento deve essere "
"registrato su un conto patrimoniale."

#. module: expodo_account_assets
#. odoo-python
#: code:addons/expodo_account_assets/models/expodo_asset.py:0
msgid ""
"%(account)s: %(cards).2f recorded on asset cards, %(ledger).2f in the ledger"
" (difference %(gap).2f)"
msgstr ""
"%(account)s: %(cards).2f sulle schede cespite, %(ledger).2f nel mastro "
"(scostamento %(gap).2f)"

#. module: expodo_account_assets
#. odoo-python
#: code:addons/expodo_account_assets/models/expodo_asset_line.py:0
msgid "%(asset)s — depreciation %(no)d/%(total)d"
msgstr "%(asset)s — ammortamento %(no)d/%(total)d"

#. module: expodo_account_assets
#. odoo-python
#: code:addons/expodo_account_assets/wizard/expodo_asset_disposal.py:0
msgid "%(asset)s — disposal"
msgstr "%(asset)s — dismissione"

#. module: expodo_account_assets
#. odoo-python
#: code:addons/expodo_account_assets/models/expodo_asset.py:0
msgid ""
"%(assets)s cannot be deleted: %(count)d depreciation entries have already "
"been posted, and deleting the asset would leave them in the ledger with "
"nothing to justify them. Dispose of the asset instead — the ledger then "
"keeps a trace of what happened."
msgstr ""
"%(assets)s non può essere eliminato: %(count)d registrazioni di ammortamento"
" sono già confermate, ed eliminare il bene le lascerebbe nel mastro senza "
"nulla a giustificarle. Dismetti invece il cespite — così il mastro conserva "
"traccia di quanto accaduto."

#. module: expodo_account_assets
#. odoo-python
#: code:addons/expodo_account_assets/models/expodo_asset.py:0
msgid ""
"%(count)d asset account(s) do not match:\n"
"\n"
"%(details)s"
msgstr ""
"%(count)d conto/i cespite non concordano:\n"
"\n"
"%(details)s"

#. module: expodo_account_assets
#. odoo-python
#: code:addons/expodo_account_assets/models/expodo_asset_line.py:0
msgid ""
"%(count)d instalments posted, from %(first)s to %(last)s, totalling "
"%(total)s."
msgstr ""
"%(count)d rate confermate, dal %(first)s al %(last)s, per un totale di "
"%(total)s."

#. module: expodo_account_assets
#: model:ir.model.constraint,message:expodo_account_assets.constraint_expodo_asset_line_amount_positive
msgid "A depreciation instalment must be strictly positive."
msgstr "Una rata di ammortamento deve essere strettamente positiva."

#. module: expodo_account_assets
#. odoo-python
#: code:addons/expodo_account_assets/models/expodo_asset_line.py:0
msgid ""
"A posted instalment cannot be deleted. Reverse its journal entry instead, so"
" the ledger keeps a trace."
msgstr ""
"Una rata confermata non può essere eliminata. Storna invece la sua "
"registrazione, così il mastro ne conserva traccia."

#. module: expodo_account_assets
#: model:ir.model.fields,help:expodo_account_assets.field_expodo_asset_disposal__account_loss_id
msgid ""
"Account charged with the remaining net book value. An expense account, "
"distinct from the ongoing depreciation charge (675 in the French chart)."
msgstr ""
"Conto addebitato del valore contabile netto residuo. Un conto di costo, "
"distinto dall'ammortamento corrente (675 nel piano francese)."

