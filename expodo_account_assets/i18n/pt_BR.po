msgid "%(asset)s — depreciation %(no)d/%(total)d"
msgstr "%(asset)s — depreciação %(no)d/%(total)d"

#. module: expodo_account_assets
#. odoo-python
#: code:addons/expodo_account_assets/wizard/expodo_asset_disposal.py:0
msgid "%(asset)s — disposal"
msgstr "%(asset)s — baixa"

#. module: expodo_account_assets
#. odoo-python
#: code:addons/expodo_account_assets/models/expodo_asset.py:0
msgid ""
"%(assets)s cannot be deleted: %(count)d depreciation entries have already "
"been posted, and deleting the asset would leave them in the ledger with "
"nothing to justify them. Dispose of the asset instead — the ledger then "
"keeps a trace of what happened."
msgstr ""
"%(assets)s não pode ser excluído: %(count)d lançamentos de depreciação já "
"foram contabilizados, e excluir o bem os deixaria no razão sem nada que os "
"justifique. Dê baixa no ativo — assim o razão mantém o rastro do que "
"aconteceu."

#. module: expodo_account_assets
#. odoo-python
#: code:addons/expodo_account_assets/models/expodo_asset.py:0
