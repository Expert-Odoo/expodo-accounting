<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_expodo_fec_export_form" model="ir.ui.view">
            <field name="name">expodo.fec.export.form</field>
            <field name="model">expodo.fec.export</field>
            <field name="arch" type="xml">
                <form string="Export FEC">
                    <sheet>
                        <group>
                            <group>
                                <field name="company_id"
                                       groups="base.group_multi_company"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                            <group invisible="not file_data">
                                <field name="file_name"/>
                                <field name="line_count"/>
                            </group>
                        </group>

                        <!--
                            Le fichier apparaît dans la même fenêtre plutôt que
                            de se télécharger tout seul : l'utilisateur voit son
                            nom et le nombre de lignes avant de l'emporter. Un
                            FEC remis à l'administration se vérifie avant, pas
                            après.
                        -->
                        <group invisible="not file_data">
                            <field name="file_data" filename="file_name"
                                   string="Download"/>
                        </group>

                        <div class="alert alert-warning" role="alert"
                             invisible="not warning">
                            <field name="warning" nolabel="1"/>
                        </div>

                        <div class="alert alert-info" role="alert"
                             invisible="file_data">
                            The file covers posted entries only, over the period
                            above. It is named from the company registration
                            number, as the 29 July 2013 order requires.
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_generate" type="object"
                                string="Generate" class="btn-primary"/>
                        <button string="Close" class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_expodo_fec_export" model="ir.actions.act_window">
            <field name="name">FEC Export</field>
            <field name="res_model">expodo.fec.export</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_expodo_fec_export"
                  name="FEC Export"
                  parent="account.menu_finance_reports"
                  action="action_expodo_fec_export"
                  sequence="95"
                  groups="account.group_account_manager"/>

    </data>
</odoo>
