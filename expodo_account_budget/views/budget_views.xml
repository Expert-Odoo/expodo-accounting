<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_expodo_budget_line_list" model="ir.ui.view">
            <field name="name">expodo.budget.line.list</field>
            <field name="model">expodo.budget.line</field>
            <field name="arch" type="xml">
                <list string="Budget lines" editable="bottom"
                      decoration-danger="variance &gt; 0 and account_id.internal_group == 'expense'"
                      decoration-success="variance &gt; 0 and account_id.internal_group == 'income'">
                    <field name="account_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="planned_amount" sum="Planned"/>
                    <field name="prorated_amount" sum="To date"/>
                    <field name="actual_amount" sum="Actual"/>
                    <field name="variance" sum="Variance"/>
                    <field name="achievement" widget="percentage" optional="show"/>
                    <field name="currency_id" column_invisible="1"/>
                    <button name="action_open_entries" type="object"
                            icon="fa-search" title="Open the entries"/>
                </list>
            </field>
        </record>

        <record id="view_expodo_budget_form" model="ir.ui.view">
            <field name="name">expodo.budget.form</field>
            <field name="model">expodo.budget</field>
            <field name="arch" type="xml">
                <form string="Budget">
                    <header>
                        <button name="action_confirm" type="object" string="Confirm"
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_close" type="object" string="Close"
                                invisible="state != 'confirmed'"/>
                        <button name="action_reset" type="object" string="Back to draft"
                                invisible="state == 'draft'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="e.g. Budget 2027"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="total_planned"/>
                                <field name="total_actual"/>
                                <field name="total_variance"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids"
                                       context="{'default_date_from': date_from,
                                                 'default_date_to': date_to}"/>
                            </page>
                        </notebook>
                        <div class="alert alert-info" role="alert">
                            “To date” is the planned amount in proportion to the
                            elapsed part of the period. Comparing three months of
                            spending with a yearly budget always looks favourable;
                            this is the figure to compare against while the period
                            is running.
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_expodo_budget_list" model="ir.ui.view">
            <field name="name">expodo.budget.list</field>
            <field name="model">expodo.budget</field>
            <field name="arch" type="xml">
                <list string="Budgets">
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="total_planned"/>
                    <field name="total_actual"/>
                    <field name="total_variance"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'confirmed'"
                           decoration-muted="state == 'done'"/>
                </list>
            </field>
        </record>

        <record id="action_expodo_budget" model="ir.actions.act_window">
            <field name="name">Budgets</field>
            <field name="res_model">expodo.budget</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Plan and compare</p>
                <p>A planned amount on its own says nothing. What is looked at is the gap: how much has been spent against how much was planned, and how far into the period.</p>
            </field>
        </record>

        <!--
            Le menu déclare ses groupes.

            Sans déclaration, il s'affichait sous Analyse pour un utilisateur
            de facturation, qui ne peut pas lire les budgets : le menu
            s'ouvrait sur une erreur de droits.
        -->
        <menuitem id="menu_expodo_budget"
                  name="Budgets"
                  parent="account.menu_finance_reports"
                  action="action_expodo_budget"
                  sequence="98"
                  groups="account.group_account_user,account.group_account_manager"/>

    </data>
</odoo>
