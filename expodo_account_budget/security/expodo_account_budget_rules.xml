<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Cloisonnement multi-société.

            Sans règle d'enregistrement, un utilisateur d'une société lit les
            enregistrements de toutes les autres : les droits d'accès du
            modèle sont satisfaits, et seule la règle pose la frontière. Rien
            ne signale la fuite, ni à l'écran ni dans les journaux.

            Le cas s'observe dès qu'un cabinet gère plusieurs dossiers dans la
            même base, ce qui est la situation ordinaire chez un intégrateur —
            c'est-à-dire chez le premier lecteur de ce module.
        -->

        <record id="rule_expodo_budget_company" model="ir.rule">
            <field name="name">Budget: multi-company</field>
            <field name="model_id" ref="model_expodo_budget"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False),
                      ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="rule_expodo_budget_line_company" model="ir.rule">
            <field name="name">Budget line: multi-company</field>
            <field name="model_id" ref="model_expodo_budget_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False),
                      ('company_id', 'in', company_ids)]
            </field>
        </record>

    </data>
</odoo>
