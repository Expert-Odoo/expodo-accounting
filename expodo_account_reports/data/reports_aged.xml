                            <field name="label">t5</field><field name="engine">domain</field>
                            <field name="formula">[('account_id.account_type', '=', 'liability_payable'), ('full_reconcile_id', '=', False)]</field>
                            <field name="subformula">aged(121,*)</field>
                        
                            <!--
                                Lecture depuis l'origine.

                                Une créance ouverte l'an dernier reste due
                                aujourd'hui. Restreindre à la période affichée
                                revenait à ne montrer que les pièces émises
                                pendant cette période — et le filtre par défaut
                                étant le mois précédent, l'état paraissait vide
                                alors que des impayés anciens dormaient dans la
                                base. C'est exactement ce que la balance âgée
                                existe pour faire remonter.
                            -->
                            <field name="date_scope">from_beginning</field>
                        </record>
                        <record id="expr_agedp_tot" model="account.report.expression">
                            <field name="label">balance</field><field name="engine">domain</field>
                            <field name="formula">[('account_id.account_type', '=', 'liability_payable'), ('full_reconcile_id', '=', False)]</field>
                            <field name="subformula">sum</field>
                        
                            <!--
                                Lecture depuis l'origine.

                                Une créance ouverte l'an dernier reste due
                                aujourd'hui. Restreindre à la période affichée
                                revenait à ne montrer que les pièces émises
                                pendant cette période — et le filtre par défaut
                                étant le mois précédent, l'état paraissait vide
                                alors que des impayés anciens dormaient dans la
                                base. C'est exactement ce que la balance âgée
                                existe pour faire remonter.
                            -->
                            <field name="date_scope">from_beginning</field>
                        </record>
                    </field>
                </record>
            </field>
        </record>

        <!-- Livres de caisse, de banque et journal : même structure, filtrée
             sur le type de journal. -->
        <record id="report_livre_banque_fr" model="account.report">
            <field name="name">Bank Book</field>
                    <field name="name@fr">Livre de banque</field>
            <field name="name@es">Libro de bancos</field>
            <field name="name@de">Bankbuch</field>
            <field name="name@nl">Bankboek</field>
            <field name="name@it">Libro banca</field>
            <field name="name@pt_BR">Livro caixa bancário</field>
            <field name="filter_date_range" eval="True"/>
            <field name="filter_multi_company">selector</field>
            <field name="default_opening_date_filter">this_month</field>
            <field name="column_ids">
                <record id="col_lb_debit" model="account.report.column">
                    <field name="name">In</field>
                    <field name="name@fr">Entrées</field>
                    <field name="name@es">Entradas</field>
                    <field name="name@de">Eingänge</field>
                    <field name="name@nl">Inkomend</field>
                    <field name="name@it">Entrate</field>
                    <field name="name@pt_BR">Entradas</field><field name="expression_label">debit</field>
                    <field name="figure_type">monetary</field><field name="sequence" eval="10"/>
                </record>
                <record id="col_lb_credit" model="account.report.column">
                    <field name="name">Out</field>
                    <field name="name@fr">Sorties</field>
                    <field name="name@es">Salidas</field>
                    <field name="name@de">Ausgänge</field>
                    <field name="name@nl">Uitgaand</field>
                    <field name="name@it">Uscite</field>
                    <field name="name@pt_BR">Saídas</field><field name="expression_label">credit</field>
                    <field name="figure_type">monetary</field><field name="sequence" eval="20"/>
                </record>
                <record id="col_lb_solde" model="account.report.column">
                    <field name="name">Balance</field>
                    <field name="name@fr">Solde</field>
                    <field name="name@es">Saldo</field>
                    <field name="name@de">Saldo</field>
                    <field name="name@nl">Saldo</field>
                    <field name="name@it">Saldo</field>
                    <field name="name@pt_BR">Saldo</field><field name="expression_label">balance</field>
                    <field name="figure_type">monetary</field><field name="sequence" eval="30"/>
                </record>
            </field>
            <field name="line_ids">
                <record id="line_lb_fr" model="account.report.line">
                    <field name="name">Bank Journals</field>
                    <field name="name@fr">Journaux de banque</field>
                    <field name="name@es">Diarios de banco</field>
                    <field name="name@de">Bankjournale</field>
                    <field name="name@nl">Bankdagboeken</field>
                    <field name="name@it">Registri banca</field>
                    <field name="name@pt_BR">Diários de banco</field>
                    <field name="code">LB_BANQUE</field>
                    <field name="groupby">journal_id,id</field>
                    <field name="foldable" eval="True"/>
                                        <!--
                        Seules les lignes du compte de banque.

                        Le domaine ne retenait que le journal, donc les deux
                        côtés de chaque écriture : le règlement d'un
                        fournisseur comptait une fois en entrée pour la
                        contrepartie et une fois en sortie pour la banque. Les
                        deux colonnes portaient le même total et le solde
                        valait invariablement zéro, sur toutes les périodes.
                    -->
<field name="expression_ids">
                        <record id="expr_lb_debit" model="account.report.expression">
                            <field name="label">debit</field><field name="engine">domain</field>
                            <field name="formula">[('journal_id.type', '=', 'bank'), ('account_id', 'in', '__bank_journal_accounts__')]</field>
                            <field name="subformula">sum_debit</field>
                            <!--
                                Mouvements de la période affichée.

                                Ces deux colonnes portent les entrées et les
                                sorties du mois consulté. Lues depuis
                                l'origine, elles cumulaient tout l'historique :
                                changer les dates ne déplaçait aucun chiffre et
                                un livre ouvert sur janvier affichait les
                                encaissements de toutes les années.
                            -->
                            <field name="date_scope">strict_range</field>
                        </record>
                        <record id="expr_lb_credit" model="account.report.expression">
                            <field name="label">credit</field><field name="engine">domain</field>
                            <field name="formula">[('journal_id.type', '=', 'bank'), ('account_id', 'in', '__bank_journal_accounts__')]</field>
                            <field name="subformula">sum_credit</field>
                            <!--
                                Mouvements de la période affichée.

                                Ces deux colonnes portent les entrées et les
                                sorties du mois consulté. Lues depuis
                                l'origine, elles cumulaient tout l'historique :
                                changer les dates ne déplaçait aucun chiffre et
                                un livre ouvert sur janvier affichait les
                                encaissements de toutes les années.
                            -->
                            <field name="date_scope">strict_range</field>
                        </record>
                        <record id="expr_lb_solde" model="account.report.expression">
                            <field name="label">balance</field><field name="engine">domain</field>
                            <field name="formula">[('journal_id.type', '=', 'bank'), ('account_id', 'in', '__bank_journal_accounts__')]</field>
                            <field name="subformula">sum</field>
                            <!--
                                Solde arrêté à la date de clôture.

                                Contrairement aux deux colonnes de mouvements,
                                le solde cumule depuis l'origine : un livre de
                                banque se lit contre un relevé, qui porte lui
                                aussi le solde du compte et non celui du mois.
                            -->
                            <field name="date_scope">from_beginning</field>
                        </record>
                    </field>
                </record>
            </field>
        </record>

