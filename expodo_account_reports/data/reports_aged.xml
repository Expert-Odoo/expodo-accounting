<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Balances âgées et livres auxiliaires de trésorerie.

            Les tranches d'ancienneté utilisent la sous-formule `aged(min, max)`,
            extension Expodo : Community ne fournit aucun mécanisme de tranche,
            et un domaine XML statique ne peut pas porter des bornes calculées
            depuis la date de clôture demandée. Les six tranches sont évaluées
            dans la même requête, par un CASE sur la date d'échéance.
        -->

        <record id="report_aged_receivable_fr" model="account.report">
            <field name="name">Aged Receivable</field>
                    <field name="name@fr">Balance âgée clients</field>
            <field name="name@es">Antigüedad de saldos de clientes</field>
            <field name="name@de">Offene Posten Debitoren</field>
            <field name="name@nl">Ouderdomsanalyse debiteuren</field>
            <field name="name@it">Scadenzario clienti</field>
            <field name="name@pt_BR">Contas a receber por idade</field>
            <!--
                L'anciennete se compte depuis aujourd'hui, jamais depuis la
                fin d'une periode close. Sans cette declaration le rapport
                retombait sur l'exercice en cours : ouvert en septembre, il
                classait les creances au 31 decembre, si bien que tout
                paraissait non echu. La correction vivait dans la base de
                developpement et non dans le module, et le test passait au
                vert sur cette valeur posee a la main.
            -->
            <field name="default_opening_date_filter">today</field>
            <!--
                Arrêté à une date, sans date de début.

                L'ancienneté se compte depuis la date de clôture : une facture
                de l'exercice précédent encore due doit apparaître dans la
                tranche la plus ancienne. Les expressions lisent donc depuis
                l'origine et la date d'ouverture n'entre dans aucun calcul.
                Affichée, elle laissait croire qu'on pouvait borner la balance
                âgée à une période.
            -->
            <field name="filter_date_range" eval="False"/>
            <field name="filter_partner" eval="True"/>
            <field name="filter_multi_company">selector</field>
            <field name="search_bar" eval="True"/>
            <field name="column_ids">
                <record id="col_agedr_0" model="account.report.column">
                    <field name="name">Not Due</field>
                    <field name="name@fr">Non échu</field>
                    <field name="name@es">No vencido</field>
                    <field name="name@de">Nicht fällig</field>
                    <field name="name@nl">Niet vervallen</field>
                    <field name="name@it">Non scaduto</field>
                    <field name="name@pt_BR">A vencer</field>
                    <field name="expression_label">t0</field>
                    <field name="figure_type">monetary</field>
                    <field name="sequence" eval="10"/>
                </record>
                <record id="col_agedr_1" model="account.report.column">
                    <field name="name">1-30</field>
                    <field name="name@fr">1 à 30 j</field>
                    <field name="name@es">1-30 d</field>
                    <field name="name@de">1-30 T</field>
                    <field name="name@nl">1-30 d</field>
                    <field name="name@it">1-30 gg</field>
                    <field name="name@pt_BR">1-30 d</field>
                    <field name="expression_label">t1</field>
                    <field name="figure_type">monetary</field>
                    <field name="sequence" eval="20"/>
                </record>
                <record id="col_agedr_2" model="account.report.column">
                    <field name="name">31-60</field>
                    <field name="name@fr">31 à 60 j</field>
                    <field name="name@es">31-60 d</field>
                    <field name="name@de">31-60 T</field>
                    <field name="name@nl">31-60 d</field>
                    <field name="name@it">31-60 gg</field>
                    <field name="name@pt_BR">31-60 d</field>
                    <field name="expression_label">t2</field>
                    <field name="figure_type">monetary</field>
                    <field name="sequence" eval="30"/>
                </record>
                <record id="col_agedr_3" model="account.report.column">
                    <field name="name">61-90</field>
                    <field name="name@fr">61 à 90 j</field>
                    <field name="name@es">61-90 d</field>
                    <field name="name@de">61-90 T</field>
                    <field name="name@nl">61-90 d</field>
                    <field name="name@it">61-90 gg</field>
                    <field name="name@pt_BR">61-90 d</field>
                    <field name="expression_label">t3</field>
                    <field name="figure_type">monetary</field>
                    <field name="sequence" eval="40"/>
                </record>
                <record id="col_agedr_4" model="account.report.column">
                    <field name="name">91-120</field>
                    <field name="name@fr">91 à 120 j</field>
                    <field name="name@es">91-120 d</field>
                    <field name="name@de">91-120 T</field>
                    <field name="name@nl">91-120 d</field>
                    <field name="name@it">91-120 gg</field>
                    <field name="name@pt_BR">91-120 d</field>
                    <field name="expression_label">t4</field>
                    <field name="figure_type">monetary</field>
                    <field name="sequence" eval="50"/>
                </record>
                <record id="col_agedr_5" model="account.report.column">
                    <field name="name">Older</field>
                    <field name="name@fr">Plus de 120 j</field>
                    <field name="name@es">Más de 120 d</field>
                    <field name="name@de">Älter als 120 T</field>
                    <field name="name@nl">Ouder dan 120 d</field>
                    <field name="name@it">Oltre 120 gg</field>
                    <field name="name@pt_BR">Mais de 120 d</field>
                    <field name="expression_label">t5</field>
                    <field name="figure_type">monetary</field>
                    <field name="sequence" eval="60"/>
                </record>
                <record id="col_agedr_tot" model="account.report.column">
                    <field name="name">Total</field>
                    <field name="name@fr">Total</field>
                    <field name="name@es">Total</field>
                    <field name="name@de">Gesamt</field>
                    <field name="name@nl">Totaal</field>
                    <field name="name@it">Totale</field>
                    <field name="name@pt_BR">Total</field>
                    <field name="expression_label">balance</field>
                    <field name="figure_type">monetary</field>
                    <field name="sequence" eval="70"/>
                </record>
            </field>
            <field name="line_ids">
                <record id="line_agedr_fr" model="account.report.line">
                    <field name="name">Customers</field>
                    <field name="name@fr">Clients</field>
                    <field name="name@es">Clientes</field>
                    <field name="name@de">Kunden</field>
                    <field name="name@nl">Klanten</field>
                    <field name="name@it">Clienti</field>
                    <field name="name@pt_BR">Clientes</field>
                    <field name="code">AGEDR</field>
                    <field name="groupby">partner_id,id</field>
                    <field name="foldable" eval="True"/>
                    <field name="expression_ids">
                        <record id="expr_agedr_t0" model="account.report.expression">
                            <field name="label">t0</field><field name="engine">domain</field>
                            <field name="formula">[('account_id.account_type', '=', 'asset_receivable'), ('full_reconcile_id', '=', False)]</field>
                            <field name="subformula">aged(-99999,0)</field>
                        
                            <!--
                                Lecture depuis l'origine.

                                Une créance ouverte l'an dernier reste due
                                aujourd'hui. Restreindre à la période affichée
                                revenait à ne montrer que les pièces émises
                                pendant cette période — et le filtre par défaut
                                étant le mois précédent, l'état paraissait vide
                                alors que des impayés anciens dormaient dans la
                                base. C'est exactement ce que la balance âgée
                                existe pour faire remonter.
                            -->
                            <field name="date_scope">from_beginning</field>
                        </record>
                        <record id="expr_agedr_t1" model="account.report.expression">
                            <field name="label">t1</field><field name="engine">domain</field>
                            <field name="formula">[('account_id.account_type', '=', 'asset_receivable'), ('full_reconcile_id', '=', False)]</field>
