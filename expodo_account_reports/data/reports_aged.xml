                        </record>
                        <record id="expr_agedr_t5" model="account.report.expression">
                            <field name="label">t5</field><field name="engine">domain</field>
                            <field name="formula">[('account_id.account_type', '=', 'asset_receivable'), ('full_reconcile_id', '=', False)]</field>
                            <field name="subformula">aged(121,*)</field>
                        
                            <!--
                                Lecture depuis l'origine.

                                Une créance ouverte l'an dernier reste due
                                aujourd'hui. Restreindre à la période affichée
                                revenait à ne montrer que les pièces émises
                                pendant cette période — et le filtre par défaut
                                étant le mois précédent, l'état paraissait vide
                                alors que des impayés anciens dormaient dans la
                                base. C'est exactement ce que la balance âgée
                                existe pour faire remonter.
                            -->
                            <field name="date_scope">from_beginning</field>
                        </record>
                        <record id="expr_agedr_tot" model="account.report.expression">
                            <field name="label">balance</field><field name="engine">domain</field>
                            <field name="formula">[('account_id.account_type', '=', 'asset_receivable'), ('full_reconcile_id', '=', False)]</field>
                            <field name="subformula">sum</field>
                        
                            <!--
                                Lecture depuis l'origine.

                                Une créance ouverte l'an dernier reste due
                                aujourd'hui. Restreindre à la période affichée
                                revenait à ne montrer que les pièces émises
                                pendant cette période — et le filtre par défaut
                                étant le mois précédent, l'état paraissait vide
                                alors que des impayés anciens dormaient dans la
                                base. C'est exactement ce que la balance âgée
                                existe pour faire remonter.
                            -->
                            <field name="date_scope">from_beginning</field>
                        </record>
                    </field>
                </record>
            </field>
        </record>

