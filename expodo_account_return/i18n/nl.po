#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/return_type.py:0
msgid "A filing deadline cannot be negative."
msgstr "Een indieningstermijn kan niet negatief zijn."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "New return"
msgstr "Nieuwe aangifte"

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "The period of “%(name)s” ends before it starts."
msgstr "De periode van ‘%(name)s’ eindigt vóór het begin."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "The filing deadline (%(date)s) has passed."
msgstr "De indieningstermijn (%(date)s) is verstreken."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "Only a draft return can be checked."
msgstr "Alleen een concept-aangifte kan worden gecontroleerd."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid ""
"No mechanical anomaly found. This does not replace a review by an "
"accountant."
msgstr ""
"Geen mechanische afwijking. Dit vervangt geen controle door een accountant."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "Return filed for %(start)s – %(end)s."
msgstr "Aangifte ingediend voor %(start)s – %(end)s."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "Only a filed return can be marked as paid."
msgstr "Alleen een ingediende aangifte kan als betaald worden gemarkeerd."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "No report is attached to this return type."
msgstr "Aan deze aangiftesoort is geen rapport gekoppeld."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "%(count)s draft entries fall in this period. They are not in the figures and will be once posted — after the return is filed."
msgstr "%(count)s conceptboekingen vallen in deze periode. Zij zitten niet in de cijfers en komen erin zodra ze geboekt zijn, dus na het indienen van de aangifte."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "A paid return cannot be reopened. Record the correction as a new return instead, which is what the tax authority expects to see."
msgstr "Een betaalde aangifte kan niet heropend worden. Leg de correctie vast als een nieuwe aangifte; dat is wat de belastingdienst verwacht."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "An earlier return of the same type is still unfiled (%(name)s). Filing out of order leaves a gap the tax authority notices before you do."
msgstr "Een eerdere aangifte van hetzelfde type is nog niet ingediend (%(name)s). Buiten volgorde indienen laat een gat achter dat de belastingdienst eerder opmerkt dan u."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "Run the checks before filing “%(name)s”. Filing is an act: it is worth two minutes of verification."
msgstr "Voer de controles uit voordat u '%(name)s' indient. Indienen is een handeling: twee minuten controle zijn het waard."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "The tax lock date (%(date)s) already covers this period, which suggests it has been filed already."
msgstr "De fiscale vergrendeldatum (%(date)s) dekt deze periode al, wat erop wijst dat zij al is ingediend."

#. module: expodo_account_return
#: model_terms:ir.actions.act_window,help:expodo_account_return.action_expodo_return
msgid "A report is consulted; a return is an act. It is filed on a date, for a period, and what it contains should no longer move."
msgstr "Een overzicht raadpleeg je; een aangifte is een handeling. Zij wordt op een datum voor een periode ingediend, en wat erin staat hoort niet meer te bewegen."

#. module: expodo_account_return
#: model_terms:ir.actions.act_window,help:expodo_account_return.action_expodo_return
msgid "Filing moves the tax lock date to the end of the period, so that an entry posted afterwards cannot silently make the books and the return disagree."
msgstr "Het indienen zet de fiscale blokkeerdatum op het einde van de periode, zodat een later geboekte post de boekhouding en de aangifte niet stilzwijgend uiteen laat lopen."

#. module: expodo_account_return
#: model_terms:ir.actions.act_window,help:expodo_account_return.action_expodo_return_type
msgid "Describe a return"
msgstr "Een aangifte beschrijven"

#. module: expodo_account_return
#: model_terms:ir.actions.act_window,help:expodo_account_return.action_expodo_return_type
msgid "A return type carries a periodicity, a filing deadline and the report to read. It is what tells a tax return which period to open on, and whether filing it locks that period."
msgstr "Een aangiftetype draagt een periodiciteit, een indieningstermijn en het te lezen overzicht. Het bepaalt op welke periode een aangifte opent en of het indienen die periode vergrendelt."

