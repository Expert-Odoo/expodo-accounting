#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/return_type.py:0
msgid "A filing deadline cannot be negative."
msgstr "Un délai de dépôt ne peut pas être négatif."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "New return"
msgstr "Nouvelle déclaration"

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "The period of “%(name)s” ends before it starts."
msgstr "La période de « %(name)s » se termine avant de commencer."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "The filing deadline (%(date)s) has passed."
msgstr "La date limite de dépôt (%(date)s) est dépassée."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "Only a draft return can be checked."
msgstr "Seule une déclaration en brouillon peut être contrôlée."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid ""
"No mechanical anomaly found. This does not replace a review by an "
"accountant."
msgstr ""
"Aucune anomalie mécanique. Cela ne remplace pas la relecture d'un comptable."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "Return filed for %(start)s – %(end)s."
msgstr "Déclaration déposée pour la période du %(start)s au %(end)s."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "Only a filed return can be marked as paid."
msgstr "Seule une déclaration déposée peut être marquée payée."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "No report is attached to this return type."
msgstr "Aucun état n'est rattaché à ce type de déclaration."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "%(count)s draft entries fall in this period. They are not in the figures and will be once posted — after the return is filed."
msgstr "%(count)s pièces en brouillon tombent dans cette période. Elles ne sont pas dans les chiffres et y seront une fois comptabilisées, c'est-à-dire après le dépôt de la déclaration."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "A paid return cannot be reopened. Record the correction as a new return instead, which is what the tax authority expects to see."
msgstr "Une déclaration payée ne peut pas être rouverte. Enregistrez plutôt la correction comme une nouvelle déclaration, ce que l'administration s'attend à voir."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "An earlier return of the same type is still unfiled (%(name)s). Filing out of order leaves a gap the tax authority notices before you do."
msgstr "Une déclaration antérieure du même type n'est toujours pas déposée (%(name)s). Déposer dans le désordre laisse un trou que l'administration remarque avant vous."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "Run the checks before filing “%(name)s”. Filing is an act: it is worth two minutes of verification."
msgstr "Lancez les contrôles avant de déposer « %(name)s ». Déposer est un acte : cela vaut deux minutes de vérification."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "The tax lock date (%(date)s) already covers this period, which suggests it has been filed already."
msgstr "La date de verrouillage fiscal (%(date)s) couvre déjà cette période, ce qui laisse penser qu'elle a déjà été déposée."

#. module: expodo_account_return
#: model_terms:ir.actions.act_window,help:expodo_account_return.action_expodo_return
msgid "A report is consulted; a return is an act. It is filed on a date, for a period, and what it contains should no longer move."
msgstr "Un état se consulte ; une déclaration est un acte. Elle est déposée à une date, pour une période, et ce qu'elle contient ne doit plus bouger."

#. module: expodo_account_return
#: model_terms:ir.actions.act_window,help:expodo_account_return.action_expodo_return
msgid "Filing moves the tax lock date to the end of the period, so that an entry posted afterwards cannot silently make the books and the return disagree."
msgstr "Le dépôt place la date de verrouillage fiscal à la fin de la période, pour qu'une écriture comptabilisée ensuite ne fasse pas diverger en silence la comptabilité et la déclaration."

#. module: expodo_account_return
#: model_terms:ir.actions.act_window,help:expodo_account_return.action_expodo_return_type
msgid "Describe a return"
msgstr "Décrire une déclaration"

#. module: expodo_account_return
#: model_terms:ir.actions.act_window,help:expodo_account_return.action_expodo_return_type
msgid "A return type carries a periodicity, a filing deadline and the report to read. It is what tells a tax return which period to open on, and whether filing it locks that period."
msgstr "Un type de déclaration porte une périodicité, un délai de dépôt et l'état à lire. C'est lui qui dit à une déclaration sur quelle période s'ouvrir, et si son dépôt verrouille cette période."

