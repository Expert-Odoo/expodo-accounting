#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/return_type.py:0
msgid "A filing deadline cannot be negative."
msgstr "Um prazo de entrega não pode ser negativo."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "New return"
msgstr "Nova declaração"

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "The period of “%(name)s” ends before it starts."
msgstr "O período de “%(name)s” termina antes de começar."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "The filing deadline (%(date)s) has passed."
msgstr "O prazo de entrega (%(date)s) expirou."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "Only a draft return can be checked."
msgstr "Somente uma declaração provisória pode ser verificada."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid ""
"No mechanical anomaly found. This does not replace a review by an "
"accountant."
msgstr ""
"Nenhuma anomalia mecânica. Isto não substitui a revisão de um contador."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "Return filed for %(start)s – %(end)s."
msgstr "Declaração entregue para o período %(start)s – %(end)s."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "Only a filed return can be marked as paid."
msgstr "Somente uma declaração entregue pode ser marcada como paga."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models/tax_return.py:0
msgid "No report is attached to this return type."
msgstr "Nenhum relatório está associado a este tipo de declaração."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "%(count)s draft entries fall in this period. They are not in the figures and will be once posted — after the return is filed."
msgstr "%(count)s lançamentos em rascunho caem neste período. Não estão nos números e passarão a estar assim que forem publicados, ou seja, depois de entregue a declaração."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "A paid return cannot be reopened. Record the correction as a new return instead, which is what the tax authority expects to see."
msgstr "Uma declaração paga não pode ser reaberta. Registe a correção como uma nova declaração, que é o que a administração espera ver."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "An earlier return of the same type is still unfiled (%(name)s). Filing out of order leaves a gap the tax authority notices before you do."
msgstr "Uma declaração anterior do mesmo tipo continua por entregar (%(name)s). Entregar fora de ordem deixa uma lacuna que a administração nota antes de si."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "Run the checks before filing “%(name)s”. Filing is an act: it is worth two minutes of verification."
msgstr "Execute as verificações antes de entregar \"%(name)s\". Entregar é um ato: vale dois minutos de conferência."

#. module: expodo_account_return
#. odoo-python
#: code:addons/expodo_account_return/models:0
msgid "The tax lock date (%(date)s) already covers this period, which suggests it has been filed already."
msgstr "A data de bloqueio fiscal (%(date)s) já cobre este período, o que sugere que já foi entregue."

#. module: expodo_account_return
#: model_terms:ir.actions.act_window,help:expodo_account_return.action_expodo_return
msgid "A report is consulted; a return is an act. It is filed on a date, for a period, and what it contains should no longer move."
msgstr "Um demonstrativo se consulta; uma declaração é um ato. Ela é entregue em uma data, para um período, e o que contém não deve mais se mexer."

#. module: expodo_account_return
#: model_terms:ir.actions.act_window,help:expodo_account_return.action_expodo_return
msgid "Filing moves the tax lock date to the end of the period, so that an entry posted afterwards cannot silently make the books and the return disagree."
msgstr "A entrega leva a data de bloqueio fiscal para o fim do período, para que um lançamento feito depois não faça a contabilidade e a declaração divergirem em silêncio."

#. module: expodo_account_return
#: model_terms:ir.actions.act_window,help:expodo_account_return.action_expodo_return_type
msgid "Describe a return"
msgstr "Descrever uma declaração"

#. module: expodo_account_return
#: model_terms:ir.actions.act_window,help:expodo_account_return.action_expodo_return_type
msgid "A return type carries a periodicity, a filing deadline and the report to read. It is what tells a tax return which period to open on, and whether filing it locks that period."
msgstr "Um tipo de declaração carrega uma periodicidade, um prazo de entrega e o demonstrativo a ler. É ele que diz a uma declaração em que período abrir, e se a entrega bloqueia esse período."

