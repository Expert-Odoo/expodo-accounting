<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_expodo_report_annotation_list" model="ir.ui.view">
            <field name="name">expodo.report.annotation.list</field>
            <field name="model">expodo.report.annotation</field>
            <field name="arch" type="xml">
                <list string="Annotations" editable="bottom">
                    <field name="report_id" readonly="1"/>
                    <field name="report_line_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="text"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_expodo_report_annotation_form" model="ir.ui.view">
            <field name="name">expodo.report.annotation.form</field>
            <field name="model">expodo.report.annotation</field>
            <field name="arch" type="xml">
                <form string="Annotation">
                    <sheet>
                        <group>
                            <group>
                                <field name="report_line_id"/>
                                <field name="report_id" readonly="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                        </group>
                        <field name="text" placeholder="Why the figure is what it is…"/>
                        <div class="alert alert-info" role="alert">
                            The annotation shows on statements whose period overlaps
                            the one above. An explanation true at one year-end is not
                            true at the next, and showing it there would be worse
                            than showing nothing.
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_expodo_report_annotation" model="ir.actions.act_window">
            <field name="name">Report Annotations</field>
            <field name="res_model">expodo.report.annotation</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Explain a figure</p>
                <p>A statement answers “how much” and never “why”. Write the why here, for whoever reads the statement next — who will not be you.</p>
            </field>
        </record>

        <!--
            Le menu déclare ses groupes.

            Les annotations accompagnent les états : elles suivent donc les
            mêmes groupes qu'eux. Sans déclaration, le menu s'affichait aussi
            pour un utilisateur de facturation sans aucun groupe comptable,
            qui ne peut pas les lire.
        -->
        <menuitem id="menu_expodo_report_annotation"
                  name="Report Annotations"
                  parent="account.menu_finance_reports"
                  action="action_expodo_report_annotation"
                  sequence="99"
                  groups="account.group_account_basic,account.group_account_readonly,account.group_account_user,account.group_account_manager"/>

    </data>
</odoo>
