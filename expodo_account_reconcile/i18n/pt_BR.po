msgid "Reconciliation difference"
msgstr "Diferença de conciliação"

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "%(lines)s items reconciled across %(groups)s partner balances. Items left unreconciled either do not net to zero or have no counterpart on the same account and partner."
msgstr "%(lines)s lançamentos conciliados em %(groups)s saldos de parceiros. Os lançamentos não conciliados não se compensam a zero ou não têm contrapartida na mesma conta e no mesmo parceiro."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "Account %(code)s is not marked as reconcilable. Tick “Allow Reconciliation” on the account if items on it are meant to be matched."
msgstr "A conta %(code)s não está marcada como conciliável. Marque \"Permitir conciliação\" na conta se os lançamentos nela devem ser casados."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "Only posted journal items can be reconciled. Post the draft entries first."
msgstr "Apenas lançamentos publicados podem ser conciliados. Publique primeiro os lançamentos em rascunho."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "Select at least two journal items: reconciling means matching them against each other."
msgstr "Selecione pelo menos dois lançamentos: conciliar é casá-los entre si."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "The selected items belong to several companies. Reconcile them company by company."
msgstr "Os lançamentos selecionados pertencem a várias empresas. Concilie-os empresa por empresa."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "The selected items sit on several accounts (%(accounts)s). Reconciliation matches items within one account."
msgstr "Os lançamentos selecionados estão em várias contas (%(accounts)s). A conciliação casa lançamentos dentro de uma mesma conta."

