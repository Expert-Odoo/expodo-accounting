msgstr "Non c'è alcuna differenza da stornare."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/wizard/reconcile_wizard.py:0
msgid "Reconciliation difference"
msgstr "Differenza di riconciliazione"

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "%(lines)s items reconciled across %(groups)s partner balances. Items left unreconciled either do not net to zero or have no counterpart on the same account and partner."
msgstr "%(lines)s movimenti riconciliati su %(groups)s saldi di partner. I movimenti non riconciliati non si compensano a zero oppure non hanno contropartita sullo stesso conto e partner."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "Account %(code)s is not marked as reconcilable. Tick “Allow Reconciliation” on the account if items on it are meant to be matched."
msgstr "Il conto %(code)s non è contrassegnato come riconciliabile. Spunta «Consenti riconciliazione» sul conto se i suoi movimenti devono essere abbinati."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "Only posted journal items can be reconciled. Post the draft entries first."
msgstr "Solo i movimenti confermati possono essere riconciliati. Conferma prima le registrazioni in bozza."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "Select at least two journal items: reconciling means matching them against each other."
msgstr "Seleziona almeno due movimenti: riconciliare significa abbinarli tra loro."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "The selected items belong to several companies. Reconcile them company by company."
msgstr "I movimenti selezionati appartengono a più società. Riconciliali società per società."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "The selected items sit on several accounts (%(accounts)s). Reconciliation matches items within one account."
msgstr "I movimenti selezionati sono su più conti (%(accounts)s). La riconciliazione abbina movimenti all'interno di uno stesso conto."

