#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "%(lines)s items reconciled across %(groups)s partner balances. Items left unreconciled either do not net to zero or have no counterpart on the same account and partner."
msgstr "%(lines)s apuntes conciliados en %(groups)s saldos de terceros. Los apuntes que quedan sin conciliar no se compensan a cero o no tienen contrapartida en la misma cuenta y el mismo tercero."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "Account %(code)s is not marked as reconcilable. Tick “Allow Reconciliation” on the account if items on it are meant to be matched."
msgstr "La cuenta %(code)s no está marcada como conciliable. Marque «Permitir conciliación» en la cuenta si sus apuntes deben casarse."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "Only posted journal items can be reconciled. Post the draft entries first."
msgstr "Solo pueden conciliarse los apuntes contabilizados. Contabilice antes los asientos en borrador."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "Select at least two journal items: reconciling means matching them against each other."
msgstr "Seleccione al menos dos apuntes: conciliar consiste en casarlos entre sí."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "The selected items belong to several companies. Reconcile them company by company."
msgstr "Los apuntes seleccionados pertenecen a varias sociedades. Concílielos sociedad por sociedad."

#. module: expodo_account_reconcile
#. odoo-python
#: code:addons/expodo_account_reconcile/models:0
msgid "The selected items sit on several accounts (%(accounts)s). Reconciliation matches items within one account."
msgstr "Los apuntes seleccionados están en varias cuentas (%(accounts)s). La conciliación casa apuntes dentro de una misma cuenta."

